<% content_for :title, "Inventario" %>

<div class="inventory">
  <header class="page-head">
    <div>
      <h1>Inventario</h1>
      <p class="page-head__sub">
        <%= pluralize(@counts[:todas], "prenda registrada", "prendas registradas") %>.
        <%= @counts[:disponibles] %> disponibles para vender.
      </p>
    </div>
    <div class="page-head__actions">
      <%= link_to "Agregar prenda", new_clothing_item_path, class: "btn btn--primary" %>
    </div>
  </header>

  <div class="filter-bar">
    <nav class="filters" aria-label="Filtrar inventario">
      <%= link_to clothing_items_path, class: "filter", aria: { current: @filter == "todas" ? "page" : nil } do %>
        Todas <span class="filter__count"><%= @counts[:todas] %></span>
      <% end %>
      <%= link_to clothing_items_path(estado: "disponibles"), class: "filter", aria: { current: @filter == "disponibles" ? "page" : nil } do %>
        Disponibles <span class="filter__count"><%= @counts[:disponibles] %></span>
      <% end %>
      <%= link_to clothing_items_path(estado: "vendidas"), class: "filter", aria: { current: @filter == "vendidas" ? "page" : nil } do %>
        Vendidas <span class="filter__count"><%= @counts[:vendidas] %></span>
      <% end %>
    </nav>
  </div>

  <% if @clothing_items.any? %>
    <div class="ledger" role="table" aria-label="Prendas">
      <div class="ledger__head" role="row">
        <span role="columnheader" class="sr-only">Talle</span>
        <span role="columnheader">Prenda</span>
        <span role="columnheader">Color</span>
        <span role="columnheader">Precio</span>
        <span role="columnheader">Estado</span>
        <span role="columnheader" class="sr-only">Acciones</span>
      </div>

      <% @clothing_items.each do |item| %>
        <div class="ledger-row" role="row">
          <div role="cell">
            <span class="size-tag <%= "size-tag--sold" if item.sold? %> <%= size_tag_modifier(item.size) %>"><%= item.size %></span>
          </div>

          <div class="ledger-row__item" role="cell">
            <%= link_to item, class: "ledger-row__name" do %><%= item.name %><% end %>
            <p class="ledger-row__owner">De <%= item.owner_name %></p>
          </div>

          <div class="ledger-row__meta" role="cell">
            <% if swatch_color(item.color) %>
              <span class="swatch" style="--swatch: <%= swatch_color(item.color) %>" aria-hidden="true"></span>
            <% else %>
              <span class="swatch swatch--unknown" aria-hidden="true"></span>
            <% end %>
            <span><%= item.color.presence || "Sin color" %></span>
          </div>

          <div class="ledger-row__price" role="cell"><%= guaranies(item.price) %></div>

          <div class="ledger-row__status" role="cell">
            <% if item.sold? %>
              <span class="status status--sold">Vendida</span>
            <% else %>
              <span class="status status--available">Disponible</span>
            <% end %>
          </div>

          <div class="ledger-row__actions" role="cell">
            <%= link_to "Ver", item, class: "link-quiet", aria: { label: "Ver #{item.name}" } %>
            <% unless item.sold? %>
              <%= link_to "Vender", new_sale_path(clothing_item_id: item.id), class: "link-action", aria: { label: "Vender #{item.name}" } %>
              <%= link_to "Editar", edit_clothing_item_path(item), class: "link-quiet", aria: { label: "Editar #{item.name}" } %>
            <% end %>
            <%= button_to "Eliminar", item, method: :delete, class: "link-danger", form: { class: "ledger-row__delete" }, data: { turbo_confirm: "¿Eliminar #{item.name}? Esta acción no se puede deshacer." }, aria: { label: "Eliminar #{item.name}" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <span class="empty__tag" aria-hidden="true"></span>
      <% if @filter == "disponibles" %>
        <h2>No hay prendas disponibles</h2>
        <p>Todo lo que registraste ya se vendió. Agregá la próxima prenda para seguir.</p>
      <% elsif @filter == "vendidas" %>
        <h2>Todavía no vendiste nada</h2>
        <p>Cuando registres una venta, la prenda va a aparecer acá.</p>
      <% else %>
        <h2>Tu inventario está vacío</h2>
        <p>Empezá etiquetando la primera prenda: nombre, talle, color, precio y dueño.</p>
      <% end %>
      <%= link_to "Agregar prenda", new_clothing_item_path, class: "btn btn--primary" %>
    </div>
  <% end %>
</div>
