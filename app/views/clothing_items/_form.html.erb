<%= form_with(model: clothing_item, class: "form-sheet") do |form| %>
  <%= render "shared/form_errors", object: clothing_item %>

  <div class="field-grid">
    <div class="field field--full field--hero">
      <%= form.label :name, "Nombre de la prenda" %>
      <%= form.text_field :name, class: "field__input", placeholder: "Campera de jean", autofocus: !clothing_item.persisted?, aria: { invalid: clothing_item.errors[:name].any? } %>
    </div>

    <div class="field">
      <%= form.label :size, "Talle" %>
      <%= form.text_field :size, class: "field__input", placeholder: "M, 38, Único", aria: { invalid: clothing_item.errors[:size].any? } %>
    </div>

    <div class="field">
      <%= form.label :color, "Color" %>
      <%= form.text_field :color, class: "field__input", placeholder: "Azul", aria: { invalid: clothing_item.errors[:color].any? } %>
    </div>

    <div class="field">
      <%= form.label :price, "Precio" %>
      <div class="money-field">
        <span class="money-field__unit" aria-hidden="true">Gs.</span>
        <%= form.number_field :price, class: "field__input", min: 0, step: 1, placeholder: "320000", aria: { invalid: clothing_item.errors[:price].any? } %>
      </div>
      <p class="field__hint">En guaraníes, sin decimales.</p>
    </div>

    <div class="field">
      <%= form.label :owner_name, "Dueño de la prenda" %>
      <%= form.text_field :owner_name, class: "field__input", placeholder: "Ana Giménez", aria: { invalid: clothing_item.errors[:owner_name].any? } %>
    </div>

    <div class="field field--full">
      <div class="check">
        <%= form.check_box :sold %>
        <div>
          <%= form.label :sold, "Marcar como vendida" %>
          <p class="check__hint">Se marca sola cuando registrás la venta. Usalo solo si necesitás corregir el estado.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= link_to "Cancelar", clothing_item.persisted? ? clothing_item_path(clothing_item) : clothing_items_path, class: "link-quiet" %>
    <div class="form-actions__main">
      <%= form.submit(clothing_item.persisted? ? "Guardar cambios" : "Agregar al inventario", class: "btn btn--primary") %>
    </div>
  </div>
<% end %>
