<% content_for :title, "Editar #{@clothing_item.name}" %>

<div class="form-page">
  <%= link_to "Volver a la prenda", @clothing_item, class: "link-back" %>

  <header class="form-head">
    <h1>Editar la etiqueta</h1>
    <p>Actualizá los datos de <%= @clothing_item.name %>. Los cambios se ven enseguida en el inventario.</p>
  </header>

  <%= render "form", clothing_item: @clothing_item %>
</div>
