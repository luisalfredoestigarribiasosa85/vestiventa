<% if user_signed_in? %>
  <% content_for :title, "Inicio" %>

  <section class="dash">
    <header class="page-head">
      <div>
        <h1>Tu tienda, en orden.</h1>
        <p class="page-head__sub">
          Tenés <%= pluralize(@available_count, "prenda disponible", "prendas disponibles") %>
          y <%= pluralize(@in_transit_count, "entrega en tránsito", "entregas en tránsito") %>.
        </p>
      </div>
      <div class="page-head__actions">
        <%= link_to "Registrar venta", new_sale_path, class: "btn btn--primary" %>
        <%= link_to "Agregar prenda", new_clothing_item_path, class: "btn btn--ghost" %>
      </div>
    </header>

    <div class="summary-grid">
      <section class="balance" aria-labelledby="balance-label">
        <div>
          <p class="balance__label" id="balance-label">Ventas acumuladas</p>
          <p class="balance__value"><%= guaranies(@total_earnings) %></p>
        </div>
        <dl class="balance__meta">
          <div>
            <dt>Disponibles</dt>
            <dd><%= @available_count %></dd>
          </div>
          <div>
            <dt>Vendidas</dt>
            <dd><%= @sold_count %></dd>
          </div>
          <div>
            <dt>En tránsito</dt>
            <dd><%= @in_transit_count %></dd>
          </div>
        </dl>
      </section>

      <section class="panel" aria-labelledby="ready-title">
        <div class="panel__head">
          <h2 id="ready-title">Listas para vender</h2>
          <%= link_to "Ver inventario", clothing_items_path, class: "panel__link" %>
        </div>

        <% if @available_items.any? %>
          <div class="ready-list">
            <% @available_items.each do |item| %>
              <div class="ready-row">
                <span class="size-tag <%= size_tag_modifier(item.size) %>"><%= item.size %></span>
                <div>
                  <p class="ready-row__name"><%= item.name %></p>
                  <p class="ready-row__owner">De <%= item.owner_name %></p>
                </div>
                <div class="ready-row__price-line">
                  <span class="ready-row__price"><%= guaranies(item.price) %></span>
                  <%= link_to "Vender", new_sale_path(clothing_item_id: item.id), class: "link-action ready-row__sell" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="panel__empty">
            <p>No hay prendas disponibles para vender.</p>
            <%= link_to "Agregar la primera prenda", new_clothing_item_path, class: "link-action" %>
          </div>
        <% end %>
      </section>
    </div>

    <section class="panel recent-panel" aria-labelledby="recent-title">
      <div class="panel__head">
        <h2 id="recent-title">Últimas ventas</h2>
        <%= link_to "Ver todas", sales_path, class: "panel__link" %>
      </div>

      <% if @recent_sales.any? %>
        <table class="mini-ledger">
          <thead>
            <tr>
              <th scope="col">Prenda</th>
              <th scope="col" class="mini-ledger__buyer">Comprador</th>
              <th scope="col">Fecha</th>
              <th scope="col" class="is-right">Precio</th>
              <th scope="col">Estado</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_sales.each do |sale| %>
              <tr>
                <td>
                  <%= link_to sale.clothing_item.name, sale, class: "mini-ledger__item" %>
                  <span class="mini-ledger__sub">Talle <%= sale.clothing_item.size %></span>
                </td>
                <td class="mini-ledger__buyer"><%= sale.buyer_name %></td>
                <td><span class="mini-ledger__date"><%= sale.created_at.strftime("%d/%m/%Y") %></span></td>
                <td class="is-right"><span class="mini-ledger__price"><%= guaranies(sale.price) %></span></td>
                <td>
                  <span class="status <%= delivery_status_css(sale) %>"><%= delivery_status_label(sale) %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="panel__empty">
          <p>Todavía no registraste ventas.</p>
          <%= link_to "Ver qué hay para vender", clothing_items_path(estado: "disponibles"), class: "link-action" %>
        </div>
      <% end %>
    </section>
  </section>
<% else %>
  <% content_for :title, "Vestiventa — cada prenda, en su lugar" %>

  <div class="landing">
    <section class="landing-hero">
      <div class="landing-hero__copy">
        <h1>Cada prenda, en su lugar.</h1>
        <p>
          Inventario, ventas y entregas de tu tienda de ropa.
          Sin planillas sueltas ni etiquetas perdidas.
        </p>
        <div class="landing-hero__actions">
          <%= link_to "Crear cuenta", new_user_registration_path, class: "btn btn--primary" %>
          <%= link_to "Iniciar sesión", new_user_session_path, class: "btn btn--ghost" %>
        </div>
      </div>

      <div class="tag-stage" aria-hidden="true">
        <div class="hang-tag hang-tag--a">
          <p class="hang-tag__brand">Vestiventa</p>
          <p class="hang-tag__name">Campera de jean</p>
          <p class="hang-tag__owner">De Ana</p>
          <div class="hang-tag__specs">
            <span class="hang-tag__size">M</span>
            <span class="hang-tag__price">Gs. 320.000</span>
          </div>
        </div>

        <div class="hang-tag hang-tag--b">
          <span class="hang-tag__stamp">Vendida</span>
          <p class="hang-tag__brand">Vestiventa</p>
          <p class="hang-tag__name">Vestido de lino</p>
          <p class="hang-tag__owner">De Rocío</p>
          <div class="hang-tag__specs">
            <span class="hang-tag__size">S</span>
            <span class="hang-tag__price">Gs. 480.000</span>
          </div>
        </div>

        <div class="hang-tag hang-tag--c">
          <p class="hang-tag__brand">Vestiventa</p>
          <p class="hang-tag__name">Saco de lana</p>
          <p class="hang-tag__owner">De Marta</p>
          <div class="hang-tag__specs">
            <span class="hang-tag__size">L</span>
            <span class="hang-tag__price">Gs. 650.000</span>
          </div>
        </div>
      </div>
    </section>

    <section class="landing-steps" aria-labelledby="steps-title">
      <div class="section-head">
        <h2 id="steps-title">Del perchero a la entrega.</h2>
      </div>
      <div class="steps">
        <article class="step">
          <p class="step__num">01</p>
          <h3>Etiquetá la prenda</h3>
          <p>Nombre, talle, color, precio y dueño. Queda en tu inventario como disponible.</p>
        </article>
        <article class="step">
          <p class="step__num">02</p>
          <h3>Registrá la venta</h3>
          <p>Elegí la prenda, el comprador y la dirección. El precio se completa solo.</p>
        </article>
        <article class="step">
          <p class="step__num">03</p>
          <h3>Seguí la entrega</h3>
          <p>Pendiente, en tránsito o entregada. Siempre sabés dónde está.</p>
        </article>
      </div>
    </section>

    <section class="landing-cta" aria-labelledby="cta-title">
      <h2 id="cta-title">Tu próxima venta empieza con una etiqueta.</h2>
      <div class="landing-cta__actions">
        <%= link_to "Crear cuenta", new_user_registration_path, class: "btn btn--primary" %>
        <%= link_to "Iniciar sesión", new_user_session_path, class: "btn btn--ghost" %>
      </div>
    </section>
  </div>
<% end %>
