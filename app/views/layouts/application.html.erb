<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Vestiventa" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Inventario, ventas y entregas para tu tienda de ropa.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>

    <%= yield :head %>

    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "vestiventa", "data-turbo-track": "reload" %>
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <%= render 'layouts/navbar' %>

    <main id="contenido" class="<%= content_for?(:main_class) ? yield(:main_class) : 'site-main' %>">
      <%= render 'layouts/flash' unless content_for?(:main_class) %>
      <%= yield %>
    </main>

    <%= render 'layouts/footer' %>
  </body>
</html>
