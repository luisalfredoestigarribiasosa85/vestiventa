<header class="site-nav">
  <div class="shell site-nav__inner">
    <%= link_to root_path, class: "wordmark" do %>
      <%= render "shared/brand_mark" %>
      <span>Vestiventa</span>
    <% end %>

    <nav class="site-nav__links" aria-label="Principal">
      <%= link_to "Inicio", root_path, class: "nav-link", aria: { current: nav_current("home") } %>
      <% if user_signed_in? %>
        <%= link_to "Inventario", clothing_items_path, class: "nav-link", aria: { current: nav_current("clothing_items") } %>
        <%= link_to "Ventas", sales_path, class: "nav-link", aria: { current: nav_current("sales") } %>
      <% end %>
    </nav>

    <div class="site-nav__end">
      <% if user_signed_in? %>
        <%= link_to current_user.email, edit_user_registration_path, class: "user-chip", title: "Tu cuenta", aria: { label: "Tu cuenta: #{current_user.email}" } %>
        <%= link_to "Registrar venta", new_sale_path, class: "btn btn--primary btn--small" %>
        <%= button_to "Salir", destroy_user_session_path, method: :delete, class: "link-quiet", form: { class: "site-nav__logout" }, aria: { label: "Cerrar sesión" } %>
      <% else %>
        <%= link_to "Iniciar sesión", new_user_session_path, class: "nav-link" %>
        <%= link_to "Crear cuenta", new_user_registration_path, class: "btn btn--primary btn--small" %>
      <% end %>
    </div>

    <details class="mobile-nav">
      <summary class="mobile-nav__toggle">Menú</summary>
      <div class="mobile-nav__panel">
        <%= link_to "Inicio", root_path, class: "mobile-nav__link" %>
        <% if user_signed_in? %>
          <%= link_to "Inventario", clothing_items_path, class: "mobile-nav__link" %>
          <%= link_to "Ventas", sales_path, class: "mobile-nav__link" %>
          <%= link_to "Registrar venta", new_sale_path, class: "btn btn--primary btn--small" %>
          <%= link_to "Tu cuenta", edit_user_registration_path, class: "mobile-nav__link" %>
          <span class="mobile-nav__email"><%= current_user.email %></span>
          <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete, class: "link-quiet mobile-nav__signout" %>
        <% else %>
          <%= link_to "Iniciar sesión", new_user_session_path, class: "mobile-nav__link" %>
          <%= link_to "Crear cuenta", new_user_registration_path, class: "btn btn--primary btn--small" %>
        <% end %>
      </div>
    </details>
  </div>
</header>
