<% content_for :title, "Recuperar contraseña" %>
<% content_for :main_class, "auth-main" %>

<div class="auth">
  <%= render "devise/shared/aside" %>

  <section class="auth__form">
    <div class="auth__inner">
      <%= render "layouts/flash" %>

      <h1>Recuperá tu acceso.</h1>
      <p class="auth__sub">Te enviamos un enlace al correo para elegir una contraseña nueva.</p>

      <div class="auth__form-sheet">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth__fields" }) do |f| %>
          <%= render "shared/form_errors", object: resource %>

          <div class="field">
            <%= f.label :email, "Correo electrónico" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field__input", placeholder: "vos@correo.com" %>
          </div>

          <%= f.submit "Enviar instrucciones", class: "btn btn--primary auth__submit" %>
        <% end %>
      </div>

      <p class="auth__alt">
        <%= link_to "Volver a iniciar sesión", new_session_path(resource_name) %>
      </p>
    </div>
  </section>
</div>
