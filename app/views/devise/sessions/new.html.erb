<% content_for :title, "Iniciar sesión" %>
<% content_for :main_class, "auth-main" %>

<div class="auth">
  <%= render "devise/shared/aside" %>

  <section class="auth__form">
    <div class="auth__inner">
      <%= render "layouts/flash" %>

      <h1>Entrá a tu tienda.</h1>
      <p class="auth__sub">Usá el correo con el que te registraste.</p>

      <div class="auth__form-sheet">
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth__fields" }) do |f| %>
          <div class="field">
            <%= f.label :email, "Correo electrónico" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field__input", placeholder: "vos@correo.com" %>
          </div>

          <div class="field">
            <%= f.label :password, "Contraseña" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "field__input" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="auth__row">
              <label class="auth__remember">
                <%= f.check_box :remember_me %>
                Recordarme
              </label>
              <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "link-quiet" %>
            </div>
          <% end %>

          <%= f.submit "Iniciar sesión", class: "btn btn--primary auth__submit" %>
        <% end %>
      </div>

      <p class="auth__alt">
        ¿Primera vez? <%= link_to "Crear una cuenta", new_registration_path(resource_name) %>
      </p>
    </div>
  </section>
</div>
