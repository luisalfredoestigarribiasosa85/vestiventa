<% content_for :title, "Tu cuenta" %>

<div class="form-page">
  <header class="form-head">
    <h1>Tu cuenta.</h1>
    <p>Actualizá tu correo o tu contraseña. Para guardar los cambios necesitamos tu contraseña actual.</p>
  </header>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "form-sheet" }) do |f| %>
    <%= render "shared/form_errors", object: resource %>

    <div class="field-grid">
      <div class="field field--full">
        <%= f.label :email, "Correo electrónico" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field__input", placeholder: "vos@correo.com" %>
      </div>

      <div class="field">
        <%= f.label :password, "Contraseña nueva" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "field__input" %>
        <p class="field__hint">Dejala en blanco si no querés cambiarla.<% if @minimum_password_length %> Mínimo <%= @minimum_password_length %> caracteres.<% end %></p>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Repetí la contraseña nueva" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field__input" %>
      </div>

      <div class="field field--full">
        <%= f.label :current_password, "Contraseña actual" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "field__input" %>
        <p class="field__hint">La usamos para confirmar cualquier cambio.</p>
      </div>
    </div>

    <div class="form-actions">
      <%= link_to "Volver al inicio", root_path, class: "link-quiet" %>
      <div class="form-actions__main">
        <%= f.submit "Guardar cambios", class: "btn btn--primary" %>
      </div>
    </div>
  <% end %>

  <section class="account-danger" aria-labelledby="account-danger-title">
    <div>
      <h2 id="account-danger-title">Dar de baja la cuenta</h2>
      <p>Se eliminan tu inventario y tus ventas. Esta acción no se puede deshacer.</p>
    </div>
    <%= button_to "Eliminar mi cuenta", registration_path(resource_name), method: :delete, class: "btn btn--ghost btn--danger", form: { class: "account-danger__form" }, data: { turbo_confirm: "¿Eliminar tu cuenta y todos tus datos? Esta acción no se puede deshacer." } %>
  </section>
</div>
