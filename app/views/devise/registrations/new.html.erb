<% content_for :title, "Crear cuenta" %>
<% content_for :main_class, "auth-main" %>

<div class="auth">
  <%= render "devise/shared/aside" %>

  <section class="auth__form">
    <div class="auth__inner">
      <%= render "layouts/flash" %>

      <h1>Abrí tu tienda.</h1>
      <p class="auth__sub">Una cuenta alcanza para empezar a etiquetar prendas.</p>

      <div class="auth__form-sheet">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth__fields" }) do |f| %>
          <%= render "shared/form_errors", object: resource %>

          <div class="field">
            <%= f.label :email, "Correo electrónico" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field__input", placeholder: "vos@correo.com" %>
          </div>

          <div class="field">
            <%= f.label :password, "Contraseña" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "field__input" %>
            <% if @minimum_password_length %>
              <p class="field__hint">Mínimo <%= @minimum_password_length %> caracteres.</p>
            <% end %>
          </div>

          <div class="field">
            <%= f.label :password_confirmation, "Repetí la contraseña" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field__input" %>
          </div>

          <%= f.submit "Crear cuenta", class: "btn btn--primary auth__submit" %>
        <% end %>
      </div>

      <p class="auth__alt">
        ¿Ya tenés cuenta? <%= link_to "Iniciar sesión", new_session_path(resource_name) %>
      </p>
    </div>
  </section>
</div>
