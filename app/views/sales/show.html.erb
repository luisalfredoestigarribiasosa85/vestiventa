<% content_for :title, "Venta ##{@sale.id}" %>

<div class="sale-detail">
  <%= link_to "Volver a ventas", sales_path, class: "link-back" %>

  <header class="page-head">
    <div>
      <h1>Venta #<%= @sale.id %></h1>
      <p class="page-head__sub">
        <%= @sale.clothing_item.name %>, vendida el <%= @sale.created_at.strftime("%d/%m/%Y") %>.
      </p>
    </div>
    <div class="page-head__actions">
      <%= link_to "Editar venta", edit_sale_path(@sale), class: "btn btn--primary" %>
      <%= link_to "Volver a ventas", sales_path, class: "btn btn--ghost" %>
      <%= button_to "Eliminar", @sale, method: :delete, class: "btn btn--ghost btn--danger", form: { class: "sale-detail__delete" }, data: { turbo_confirm: "¿Eliminar la venta # #{@sale.id}? Esta acción no se puede deshacer." } %>
    </div>
  </header>

  <%= render @sale %>
</div>
