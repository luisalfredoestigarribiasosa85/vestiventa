<% if @available_items.any? %>
  <%= form_with(model: sale, class: "form-sheet", data: { controller: "sale-form" }) do |form| %>
    <%= render "shared/form_errors", object: sale %>

    <div class="field-grid">
      <div class="field field--full">
        <%= form.label :clothing_item_id, "Prenda a vender" %>
        <%= form.select :clothing_item_id,
            options_for_select(
              @available_items.map { |item| ["#{item.name}, talle #{item.size}, #{guaranies(item.price)}", item.id, { data: { price: item.price.to_i } }] },
              sale.clothing_item_id
            ),
            { prompt: "Elegí una prenda" },
            class: "field__select",
            aria: { invalid: sale.errors[:clothing_item_id].any? },
            data: { sale_form_target: "item", action: "change->sale-form#updatePrice" } %>
      </div>

      <div class="field">
        <%= form.label :price, "Precio de venta" %>
        <div class="money-field">
          <span class="money-field__unit" aria-hidden="true">Gs.</span>
          <%= form.number_field :price,
              value: sale.price.presence&.to_i,
              class: "field__input",
              min: 1,
              step: 1,
              aria: { invalid: sale.errors[:price].any? },
              data: { sale_form_target: "price" } %>
        </div>
        <p class="field__hint" data-sale-form-target="originalPrice">Se completa con el precio de la prenda.</p>
      </div>

      <div class="field">
        <%= form.label :delivery_status, "Estado de entrega" %>
        <%= form.select :delivery_status,
            Sale.delivery_statuses.keys.map { |status| [t("sales.delivery_status.#{status}", default: status.humanize), status] },
            {},
            class: "field__select" %>
      </div>

      <div class="field">
        <%= form.label :buyer_name, "Nombre del comprador" %>
        <%= form.text_field :buyer_name, class: "field__input", placeholder: "Rocío Benítez", autocomplete: "name", aria: { invalid: sale.errors[:buyer_name].any? } %>
      </div>

      <div class="field">
        <%= form.label :address, "Dirección de entrega" %>
        <%= form.text_field :address, class: "field__input", placeholder: "Av. Mcal. López 1234, Asunción", autocomplete: "street-address", aria: { invalid: sale.errors[:address].any? } %>
      </div>
    </div>

    <div class="form-actions">
      <%= link_to "Cancelar", sale.persisted? ? sale_path(sale) : sales_path, class: "link-quiet" %>
      <div class="form-actions__main">
        <%= form.submit(sale.persisted? ? "Guardar cambios" : "Registrar venta", class: "btn btn--primary") %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="empty">
    <span class="empty__tag" aria-hidden="true"></span>
    <h2>No hay prendas para vender</h2>
    <p>Todo lo que tenés en el inventario ya está vendido. Agregá una prenda nueva para registrar la próxima venta.</p>
    <%= link_to "Agregar prenda", new_clothing_item_path, class: "btn btn--primary" %>
  </div>
<% end %>
