<% content_for :title, "Editar venta ##{@sale.id}" %>

<div class="form-page">
  <%= link_to "Volver a la venta", @sale, class: "link-back" %>

  <header class="form-head">
    <h1>Editar la venta</h1>
    <p>Actualizá el comprador, la dirección o el estado de entrega de la venta #<%= @sale.id %>.</p>
  </header>

  <%= render "form", sale: @sale %>
</div>
