<% content_for :title, "Ventas" %>

<div class="sales">
  <header class="page-head">
    <div>
      <h1>Ventas</h1>
      <p class="page-head__sub">Seguí cada venta hasta la entrega.</p>
    </div>
    <div class="page-head__actions">
      <%= link_to "Registrar venta", new_sale_path, class: "btn btn--primary" %>
    </div>
  </header>

  <dl class="stat-strip">
    <div>
      <dt>Ventas acumuladas</dt>
      <dd><%= guaranies(@total_earnings) %></dd>
    </div>
    <div>
      <dt>Operaciones</dt>
      <dd><%= @counts[:todas] %></dd>
    </div>
    <div>
      <dt>En tránsito</dt>
      <dd><%= @counts[:en_transito] %></dd>
    </div>
  </dl>

  <div class="filter-bar">
    <nav class="filters" aria-label="Filtrar ventas">
      <%= link_to sales_path, class: "filter", aria: { current: @filter == "todas" ? "page" : nil } do %>
        Todas <span class="filter__count"><%= @counts[:todas] %></span>
      <% end %>
      <%= link_to sales_path(estado: "pendientes"), class: "filter", aria: { current: @filter == "pendientes" ? "page" : nil } do %>
        Pendientes <span class="filter__count"><%= @counts[:pendientes] %></span>
      <% end %>
      <%= link_to sales_path(estado: "en_transito"), class: "filter", aria: { current: @filter == "en_transito" ? "page" : nil } do %>
        En tránsito <span class="filter__count"><%= @counts[:en_transito] %></span>
      <% end %>
      <%= link_to sales_path(estado: "entregadas"), class: "filter", aria: { current: @filter == "entregadas" ? "page" : nil } do %>
        Entregadas <span class="filter__count"><%= @counts[:entregadas] %></span>
      <% end %>
    </nav>
  </div>

  <% if @sales.any? %>
    <div class="ledger ledger--sales" role="table" aria-label="Ventas">
      <div class="ledger__head" role="row">
        <span role="columnheader">Fecha</span>
        <span role="columnheader">Prenda</span>
        <span role="columnheader">Comprador</span>
        <span role="columnheader">Precio</span>
        <span role="columnheader">Entrega</span>
        <span role="columnheader" class="sr-only">Acciones</span>
      </div>

      <% @sales.each do |sale| %>
        <div class="ledger-row" role="row">
          <div role="cell">
            <time class="ledger-row__date" datetime="<%= sale.created_at.iso8601 %>"><%= sale.created_at.strftime("%d/%m/%Y") %></time>
          </div>

          <div class="ledger-row__item" role="cell">
            <%= link_to sale.clothing_item.name, sale, class: "ledger-row__name" %>
            <p class="ledger-row__owner">Talle <%= sale.clothing_item.size %>, <%= sale.clothing_item.color %></p>
          </div>

          <div class="ledger-row__buyer" role="cell">
            <p class="ledger-row__buyer-name"><%= sale.buyer_name %></p>
            <p class="ledger-row__buyer-address"><%= sale.address %></p>
          </div>

          <div class="ledger-row__price" role="cell">
            <%= guaranies(sale.price) %>
            <% if sale.price != sale.clothing_item.price %>
              <span class="ledger-row__original"><%= guaranies(sale.clothing_item.price) %></span>
            <% end %>
          </div>

          <div class="ledger-row__status" role="cell">
            <span class="status <%= delivery_status_css(sale) %>"><%= delivery_status_label(sale) %></span>
          </div>

          <div class="ledger-row__actions" role="cell">
            <%= link_to "Ver", sale, class: "link-quiet", aria: { label: "Ver venta de #{sale.clothing_item.name}" } %>
            <%= link_to "Editar", edit_sale_path(sale), class: "link-quiet", aria: { label: "Editar venta de #{sale.clothing_item.name}" } %>
            <%= button_to "Eliminar", sale, method: :delete, class: "link-danger", form: { class: "ledger-row__delete" }, data: { turbo_confirm: "¿Eliminar la venta de #{sale.clothing_item.name}? Esta acción no se puede deshacer." }, aria: { label: "Eliminar venta de #{sale.clothing_item.name}" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <span class="empty__tag" aria-hidden="true"></span>
      <% if @filter == "pendientes" %>
        <h2>No hay entregas pendientes</h2>
        <p>Todo lo que vendiste ya salió o llegó a destino.</p>
      <% elsif @filter == "en_transito" %>
        <h2>Nada en tránsito</h2>
        <p>Cuando una venta salga a entrega, va a aparecer acá.</p>
      <% elsif @filter == "entregadas" %>
        <h2>Todavía no hay entregas confirmadas</h2>
        <p>Actualizá el estado de una venta cuando llegue a destino.</p>
      <% else %>
        <h2>Todavía no registraste ventas</h2>
        <p>Elegí una prenda disponible y registrá la primera venta de tu tienda.</p>
      <% end %>
      <%= link_to "Registrar venta", new_sale_path, class: "btn btn--primary" %>
    </div>
  <% end %>
</div>
