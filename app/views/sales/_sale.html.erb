<article id="<%= dom_id sale %>" class="receipt">
  <header class="receipt__head">
    <p class="receipt__brand">Vestiventa</p>
    <h2>Venta #<%= sale.id %></h2>
    <p class="receipt__date"><%= sale.created_at.strftime("%d/%m/%Y, %H:%M") %> hs</p>
  </header>

  <div class="receipt__status">
    <span class="status <%= delivery_status_css(sale) %>"><%= delivery_status_label(sale) %></span>
  </div>

  <dl class="receipt__rows">
    <div class="receipt__row">
      <dt>Prenda</dt>
      <dd>
        <%= sale.clothing_item.name %>
        <span>Talle <%= sale.clothing_item.size %>, <%= sale.clothing_item.color %></span>
      </dd>
    </div>
    <div class="receipt__row">
      <dt>Comprador</dt>
      <dd><%= sale.buyer_name %></dd>
    </div>
    <div class="receipt__row">
      <dt>Dirección</dt>
      <dd><%= sale.address %></dd>
    </div>
    <div class="receipt__row">
      <dt>Dueño de la prenda</dt>
      <dd><%= sale.clothing_item.owner_name %></dd>
    </div>
    <div class="receipt__row">
      <dt>Etiqueta</dt>
      <dd class="mono"><%= sale.clothing_item.id.to_s.rjust(4, "0") %></dd>
    </div>
  </dl>

  <div class="receipt__total">
    <span>Total</span>
    <strong><%= guaranies(sale.price) %></strong>
  </div>

  <% if sale.price != sale.clothing_item.price %>
    <p class="receipt__original">Precio de la prenda: <s><%= guaranies(sale.clothing_item.price) %></s></p>
  <% end %>

  <footer class="receipt__foot">
    <span>Registrada por <%= sale.user&.email || sale.clothing_item.user.email %></span>
    <span>Vestiventa</span>
  </footer>
</article>
